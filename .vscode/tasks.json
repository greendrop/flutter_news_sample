{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
    {
      "label": "flutter pub get",
      "detail": "パッケージの取得",
      "type": "flutter",
      "command": "flutter",
      "args": [
        "pub",
        "get"
      ]
    },
    {
      "label": "dart run build_runner build (app)",
      "detail": "build_runner による自動生成 (app)",
      "type": "dart",
      "command": "dart",
      "args": [
        "run",
        "build_runner",
        "build"
      ],
      "cwd": "packages/app"
    },
    {
      "label": "dart run build_runner build --delete-conflicting-outputs (app)",
      "detail": "build_runner による競合する出力を削除して自動生成 (app)",
      "type": "dart",
      "command": "dart",
      "args": [
        "run",
        "build_runner",
        "build",
        "--delete-conflicting-outputs"
      ],
      "cwd": "packages/app"
    },
    {
      "label": "dart run build_runner build (widgetbook)",
      "detail": "build_runner による自動生成 (widgetbook)",
      "type": "dart",
      "command": "dart",
      "args": [
        "run",
        "build_runner",
        "build"
      ],
      "cwd": "packages/widgetbook"
    },
    {
      "label": "dart run build_runner build --delete-conflicting-outputs (widgetbook)",
      "detail": "build_runner による競合する出力を削除して自動生成 (widgetbook)",
      "type": "dart",
      "command": "dart",
      "args": [
        "run",
        "build_runner",
        "build",
        "--delete-conflicting-outputs"
      ],
      "cwd": "packages/widgetbook"
    },
    {
      "label": "dart run flutter_launcher_icons (app)",
      "detail": "アイコンの自動生成 (app)",
      "type": "dart",
      "command": "dart",
      "args": [
        "run",
        "flutter_launcher_icons"
      ],
      "cwd": "packages/app"
    },
    {
      "label": "dart run flutter_native_splash:create (app)",
      "detail": "スプラッシュの自動生成 (app)",
      "type": "dart",
      "command": "dart",
      "args": [
        "run",
        "flutter_native_splash:create"
      ],
      "cwd": "packages/app"
    },
    {
      "label": "flutter test (app)",
      "detail": "テストを実行 (app)",
      "type": "dart",
      "command": "flutter",
      "args": [
        "test"
      ],
      "cwd": "packages/app"
    },
    {
      "label": "flutter test --exclude-tags golden (app)",
      "detail": "golden タグを除外してテストを実行 (app)",
      "type": "dart",
      "command": "flutter",
      "args": [
        "test",
        "--exclude-tags",
        "golden"
      ],
      "cwd": "packages/app"
    },
    {
      "label": "flutter test --tags golden (app)",
      "detail": "golden タグのテストを実行",
      "type": "dart",
      "command": "flutter",
      "args": [
        "test",
        "--tags",
        "golden"
      ],
      "cwd": "packages/app"
    },
    {
      "label": "flutter test --update-goldens --tags golden (app)",
      "detail": "golden タグのテストを実行してゴールデンファイルを更新 (app)",
      "type": "dart",
      "command": "flutter",
      "args": [
        "test",
        "--update-goldens",
        "--tags",
        "golden"
      ],
      "cwd": "packages/app"
    },
    {
      "label": "flutter drive --dart-define-from-file dart_define/integration_test_ios.json --driver test_driver/integration_test.dart --target integration_test/suite/general_test.dart (app)",
      "detail": "iOS シミュレーターでの統合テスト (app)",
      "type": "dart",
      "command": "flutter",
      "args": [
        "drive",
        "--dart-define-from-file",
        "dart_define/integration_test_ios.json",
        "--driver",
        "test_driver/integration_test.dart",
        "--target",
        "integration_test/suite/general_test.dart"
      ],
      "cwd": "packages/app"
    },
    {
      "label": "flutter drive --dart-define-from-file dart_define/integration_test_android.json --driver test_driver/integration_test.dart --target integration_test/suite/general_test.dart (app)",
      "detail": "Android シミュレーターでの統合テスト (app)",
      "type": "dart",
      "command": "flutter",
      "args": [
        "drive",
        "--dart-define-from-file",
        "dart_define/integration_test_android.json",
        "--driver",
        "test_driver/integration_test.dart",
        "--target",
        "integration_test/suite/general_test.dart"
      ],
      "cwd": "packages/app"
    },
    {
      "label": "flutter test --tags golden (widgetbook)",
      "detail": "golden タグのテストを実行 (widgetbook)",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "PREFIX=$(basename $(pwd))_ && docker buildx build --platform linux/x86_64 -t ${PREFIX}flutter_golden_test docker/flutter_golden_test && docker volume create ${PREFIX}flutter_golden_test_dart_tool && docker run --rm -v $(pwd):/app -v ${PREFIX}flutter_golden_test_dart_tool:/app/.dart_tool -w /app/packages/widgetbook --platform linux/x86_64 -it ${PREFIX}flutter_golden_test flutter test --tags golden"
      ],

    },
    {
      "label": "flutter test --update-goldens --tags golden (widgetbook)",
      "detail": "golden タグのテストを実行してゴールデンファイルを更新 (widgetbook)",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "PREFIX=$(basename $(pwd))_ && docker buildx build --platform linux/x86_64 -t ${PREFIX}flutter_golden_test docker/flutter_golden_test && docker volume create ${PREFIX}flutter_golden_test_dart_tool && docker run --rm -v $(pwd):/app -v ${PREFIX}flutter_golden_test_dart_tool:/app/.dart_tool -w /app/packages/widgetbook --platform linux/x86_64 -it ${PREFIX}flutter_golden_test flutter test --update-goldens --tags golden"
      ],
    },
    {
      "label": "npm run textlint",
      "detail": "textlint による文章チェック",
      "type": "npm",
      "script": "textlint",
    }
  ]
}